+def _reading(o: BendOutcome, cid: str) -> tuple:
+    if cid in o.stage_na:
+        return ("NA",)
+    if cid in o.forced_unknown:
+        return ("UNKNOWN",)
+    m = o.measurements.get(cid)
+    if m is None or m.value is None or m.u is None:
+        return ("UNKNOWN",)
+    return ("M", float(m.value), max(float(m.u), 1e-6))
