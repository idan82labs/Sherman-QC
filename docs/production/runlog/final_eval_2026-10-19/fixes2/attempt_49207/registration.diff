+def _stage_material_beyond_free_edges(part: PartView, p0: np.ndarray, n0: np.ndarray, f1: np.ndarray, f2: np.ndarray,
+                                      poly: np.ndarray, free: np.ndarray, reach: float = 25.0) -> np.ndarray:
+    """2D compiled stage material (S_0, S_N; datum slab) outside the datum outline, within ``reach`` of a free edge
+    and 0.3 mm clear of the outline (see ``DatumModel.edge_blocked``)."""
+    if not free.any():
+        return np.zeros((0, 2))
+    chunks = []
+    for sid in ("S0", f"S{part.n}"):
+        if sid not in part.stages:
+            continue
+        pts = part.cloud(sid).points
+        h = (pts - p0) @ n0
+        q = pts[(h > -part.t - 0.5) & (h < 0.5)] - p0
+        chunks.append(np.stack([q @ f1, q @ f2], axis=1))
+    uv = np.vstack(chunks) if chunks else np.zeros((0, 2))
+    if not len(uv):
+        return np.zeros((0, 2))
+    k = len(poly)
+    samples = []
+    for i in range(k):
+        if free[i]:
+            a, b = poly[i], poly[(i + 1) % k]
+            n_s = max(2, int(math.ceil(float(np.linalg.norm(b - a)) / 0.5)) + 1)
+            samples.append(a + np.linspace(0.0, 1.0, n_s)[:, None] * (b - a))
+    d_f, _ = cKDTree(np.vstack(samples)).query(uv, k=1, distance_upper_bound=reach, workers=1)
+    uv = uv[np.isfinite(d_f)]
+    if len(uv):
+        uv = uv[~MplPath(poly).contains_points(uv)]
+    if len(uv):
+        uv = uv[_distance_to_polyline(uv, np.vstack([poly, poly[:1]])) > 0.3]
+    return np.asarray(uv, dtype=np.float64).reshape(-1, 2)
 
 
