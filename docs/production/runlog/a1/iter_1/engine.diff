+            tau = (u - float((oq0 - self.origin) @ self.a_dir)) / float(od @ self.a_dir)
+            return float((oq0 + tau * od - self.origin) @ w_dir)
+        w, _ = _uw_crossings(self.starts, self.ends, u)
+        return float(w.max()) if len(w) else None
