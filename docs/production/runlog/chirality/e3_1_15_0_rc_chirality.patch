+def _count_pass(outcomes: list[BendOutcome], general: dict, part: PartView) -> int:
+    """Decided PASS characteristics as they stand (bookkeeping: what the result would carry without the check)."""
+    n = 0
+    items = [(cid, m, o) for o in outcomes for cid, m in o.measurements.items()] + \
+        [(cid, m, None) for cid, m in general.items()]
+    for cid, m, o in items:
+        if m.value is None or m.u is None or (o is not None and (cid in o.forced_unknown or cid in o.stage_na)):
+            continue
+        if o is not None and o.state in ("UNKNOWN", "NOT_YET_FORMED"):
+            continue
+        n += int(_gb(part.nominals.get(cid), m.value, m.u) == "PASS")
+    return n
+
+
+def _chirality_withhold(outcomes: list[BendOutcome], general: dict, part: PartView, reason: str, ctx: "_Ctx") -> None:
+    """e3-1.15: the part's left/right identity is not confirmed: every PASS becomes REVIEW (U raised to the guard
+    band, :func:`withhold_u`). FAIL and everything undecided are untouched; nothing becomes PASS."""
+    n = 0
+    items = [(cid, m, o) for o in outcomes for cid, m in o.measurements.items()] + \
+        [(cid, m, None) for cid, m in general.items()]
+    for cid, m, o in items:
+        if m.value is None or m.u is None or (o is not None and (cid in o.forced_unknown or cid in o.stage_na)):
+            continue
+        if o is not None and o.state in ("UNKNOWN", "NOT_YET_FORMED"):
+            continue
+        nom = part.nominals.get(cid)
+        if _gb(nom, m.value, m.u) != "PASS":
+            continue
+        m.u = withhold_u(nom, m.value, float(m.u), 0.0)
+        m.notes = tuple(m.notes) + ("LEFT_RIGHT_UNCONFIRMED",)
+        n += 1
+    ctx.warnings.append(f"LEFT_RIGHT_UNCONFIRMED: {reason}; the part's left/right variant could not be confirmed "
+                        f"from its distinguishing features; {n} PASS characteristic(s) withheld (REVIEW)")
+    ctx.note(f"chirality withhold: {n} PASS -> REVIEW ({reason})")
 
 
 def _mirror_voxels(vox: VoxelCloud) -> VoxelCloud:
