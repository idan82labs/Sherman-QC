+def _mi_write(info: dict) -> None:
+    """[e3-mirror prototype] research log line (E3M_LOG), no effect on the result."""
+    import json as _json, os as _os
+    if _os.environ.get("E3M_LOG"):
+        with open(_os.environ["E3M_LOG"], "a") as fh:
+            fh.write(_json.dumps(info, default=float) + "\n")
