 "new_conventions": [
  {
   "id": "NC1",
   "items": [
    "gb_1baa22",
    "gb_d11e33",
    "gb_231669",
    "gb_ac2239"
   ],
   "decision": "Open (gapped) 180 deg hems count as 1 line on the outer crown, built with the D0 tangent-band construction, exactly like the closed hem of D0 gb_44b168.",
   "why_new": "D0 ruled on a closed hem only. Physically an open hem is the same formed 180 deg fold (>= 10 deg) with a gap between the legs; the GOLD_SET_V2 rule counts it. Effect: +6 lines over 4 items (1, 1, 2, 2)."
  },
  {
   "id": "NC2",
   "items": [
    "gb_b3ae40",
    "gb_b97c8e"
   ],
   "decision": "On a fold interrupted by windows so large that the fold exists only at short rungs, the gold keeps the tool's envelope apex (the outermost material, mostly rail-edge corners between rungs) instead of the rung arc apex. Measured offset from the rung arc apex: 0.85 mm (b3ae40), 0.93-1.25 mm (b97c8e).",
   "why_new": "T4/T6 preferred a station-checked outer-skin apex when a better line existed; here no tool construction gives a full-length line on the rung apex. The offset is inside the 4 mm tolerance; per-rung lines were not used because the windows rule decides the count."
  },
  {
   "id": "NC3",
   "items": [
    "gb_d1093e",
    "gb_a2dd83"
   ],
   "decision": "Formed-fold test for short or ambiguous pieces: if the outer material at the bisector sits closer to the plane sharp than any formed fold of that thickness allows ((sqrt2 - 1) * t for 90 deg, i.e. Ri = 0), at every station, the junction is a sharp/abutting corner and not a bend; if it sits at the expected formed-apex offset over >= 80 % of the line, it is a formed fold.",
   "why_new": "It puts the T1 'concentric arc vs sharp corner' ruling into a number. It rejects d1093e B21/B22 and accepts a2dd83 B12/B13."
  },
  {
   "id": "NC4",
   "items": [
    "gb_68cd06"
   ],
   "decision": "The adjudicator added the patch-9 end hem of gb_68cd06 (MISSING_ADD) on its own raw-scan sections, with no third marking. Neither marker drew it; marker A noted the overlap but called it unclear.",
   "why_new": "Earlier MISSING_ADDs (T1, T4) came from a FRESH third marking. Here the adjudicator's evidence is the section (2t closed stack with a rounded crown). The owner may want a third marking to confirm."
  }
 ],
