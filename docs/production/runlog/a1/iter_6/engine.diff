+    lo = max(-cfg.theta_min_deg, min(cfg.flat_sweep_max_deg, cfg.flat_fraction_max * sweep_deg)) + 1.0
+    hi = min(sweep_deg + cfg.theta_overbend_deg, 180.0 - cfg.reversed_wrap_margin_deg - 1.0)
