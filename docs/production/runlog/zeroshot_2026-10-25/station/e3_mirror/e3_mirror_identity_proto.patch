+def _near_mirror_maps(part: PartView, stage_id: str | None, cfg: InspectConfig) -> list[np.ndarray]:
+    """[e3-mirror prototype] Uncertified near mirror images of compiled stage ``stage_id``: E1 MIRROR candidates above
+    the stage's symmetry threshold but within ``near_twin_rms_mm`` (a part that is its own mirror image except for a
+    few features), deduplicated. [] for no exact stage or a stage E1 certifies as mirror-symmetric."""
+    out: list[np.ndarray] = []
+    for stage in part.compiled.stages:
+        if stage_id is None or stage.stage_model_id != stage_id:
+            continue
+        sym = stage.symmetry
+        if any(c.kind == "MIRROR" and c.rms_mm <= sym.threshold_rms_mm + 1e-12 for c in sym.candidates):
+            return []
+        for cand in sym.candidates:
+            if cand.kind == "MIRROR" and cand.rms_mm <= float(cfg.near_twin_rms_mm):
+                m = np.asarray(cand.transform, dtype=np.float64)
+                if not any(np.allclose(m, o, atol=1e-3) for o in out):
+                    out.append(m)
+    return out
+
+
+def _mirror_identity(proper: list["_Hyp"], mirrored: list["_Hyp"], pts, vox, mpts, mvox, part: PartView,
+                     cfg: InspectConfig, spacing: float, *, symmetric: bool, stage_known: bool, note,
+                     info: dict) -> str | None:
+    """[e3-mirror prototype] The MIRRORED_PART_SUSPECTED reason of the mirror identity check, or None.
+
+    The best proper and mirrored fits are compared on their complete articulated fits. Holes first, on every fitted
+    panel (:func:`_hole_evidence`, the best confirmed-minus-contradicted score among the poses within
+    ``ambiguity_margin`` of each side's best total): a mirrored fit whose holes score ``hole_evidence_min_diff``
+    better, with a total and an explained share that are not lower, is the mirrored part. For a chiral stage (no
+    certified mirror self-map, or a certified one after the mirrored fit was converted to a proper pose; the mirrored
+    fit's decode names an exact stage) a mirrored fit whose total still beats the best proper one by
+    ``mirror_identity_margin``, or (any decode) one which explains
+    ``mirror_identity_explained_gain`` more of the scan without a lower total, is the mirrored part too, unless its
+    holes score lower."""
+    P = sorted([h for h in proper if h.art is not None], key=lambda h: -h.total)
+    M = sorted([h for h in mirrored if h.art is not None], key=lambda h: -h.total)
+    if not P or not M:
+        return None
+    if max(P[0].explained, M[0].explained) < cfg.wrong_part_explained_min:
+        return None  # neither image explains the scan: the wrong-part check speaks, not the mirror one
+    pool_p = [h for h in P if h.total >= P[0].total - cfg.ambiguity_margin][:3]
+    pool_m = [h for h in M if h.total >= M[0].total - cfg.ambiguity_margin][:3]
+    hp = max(c - x for c, x in (_hole_evidence(h, pts, vox, part, cfg, spacing) for h in pool_p))
+    hm = max(c - x for c, x in (_hole_evidence(h, mpts, mvox, part, cfg, spacing) for h in pool_m))
+    dt = M[0].total - P[0].total
+    de = max(h.explained for h in pool_m) - max(h.explained for h in pool_p)
+    info.update(hole_p=hp, hole_m=hm, dt=dt, de=de, symmetric=symmetric, stage_known=stage_known)
+    note(f"mirror identity: total {P[0].total:.4f} vs mirrored {M[0].total:.4f}, explained gain {de:+.4f}, "
+         f"holes {hp} vs mirrored {hm}")
+    if hm - hp >= cfg.hole_evidence_min_diff and dt >= -cfg.ambiguity_margin and de >= 0.0:
+        return f"MIRROR_HOLES_FIT_BETTER:{hm}>{hp}"
+    if hm < hp:
+        return None
+    # the total margin needs an exact decoded stage: only then is a certified mirror symmetry converted first (an
+    # inexact decode of a mirror-symmetric part leaves the proper search's misses to look like a better mirror)
+    if stage_known and dt > cfg.mirror_identity_margin:
+        return f"MIRROR_FITS_BETTER:{M[0].total:.3f}>{P[0].total:.3f}"
+    if de >= cfg.mirror_identity_explained_gain and dt >= 0.0:
+        return f"MIRROR_EXPLAINS_MORE:{de:+.3f}"
     return None
 
 
